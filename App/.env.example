# 是否开启异常捕获日志脱敏password,token等,生产环境建议开启
ENABLE_LOG_SANITIZE=false

#cron service debug配置,默认开启
CRON_DEBUG=true

#每个Agent机器节点的ID不同
CRON_NODE_ID=1
# 创建节点时返回的 apiKey，写入 Agent 环境变量
CRON_NODE_API_KEY=


# 登录token有效期,单位秒
AUTH_JWT_TTL=7200

#mysqL配置(需替换实际MySQL地址)
DB_HOST_NAME=192.168.1.102
DB_HOST_DATABASE=bingcool
DB_USER_NAME=root
DB_PASSWORD=123456
DB_HOST_PORT=3306