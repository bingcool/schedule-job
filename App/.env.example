# -------- Admin Manager 和 Agent Node 服务部署时公共配置项 --------

# 当前环境(dev,test,gra,prd)
APP_ENV=dev
# cron service debug配置,默认开启
CRON_DEBUG=true

# mysqL配置(需替换实际MySQL地址)
DB_HOST_NAME=127.0.0.1
DB_HOST_DATABASE=xxxxx
DB_USER_NAME=xxxx
DB_PASSWORD=xxxxx
DB_HOST_PORT=3306




# -------- Admin Manager 服务部署时公共配置项 --------
# 登录token有效期,单位秒
AUTH_JWT_TTL=86400
# 关闭csp浏览器拦截
SECURITY_HEADERS_ENABLED=false
# 是否开启异常捕获日志脱敏password,token等,生产环境建议开启
ENABLE_LOG_SANITIZE=false
# 定时删除7天前的cron_task_log
CRON_TASK_LOG_DELETE_DAY=7





# -------- Agent Node 服务部署时公共配置项 --------
#每个Agent机器节点的ID不同
CRON_NODE_ID=1
# 创建节点时返回的 apiKey，写入 Agent 环境变量
CRON_NODE_API_KEY=xxxx
# cron_task_log.message 追加上限（字节）。不设置默认 30000；显式设置不能超过 60000，否则启动抛异常
CRON_TASK_LOG_MESSAGE_MAX_BYTES=30000
# Execution Lease 有效期（秒）。不设置默认60；显式设置不能小于20，否则 Agent 启动抛异常。建议默认值60
EXECUTION_LEASE_DURATION=60
# Crash Recovery 扫描间隔（秒）。不设置默认30，建议使用默认值30
EXECUTION_LEASE_RECOVERY_INTERVAL=30
# Shell 超时/取消时 SIGTERM 后等待秒数，再 SIGKILL。不设置默认10，建议使用默认值10
EXECUTION_TERMINATE_GRACE_PERIOD=10


# ---------- 群机器人 Webhook ----------
# 群机器人 Webhook 超时（秒）。不设置默认 10 / 20
# ROBOT_CONNECT_TIMEOUT=10
# ROBOT_REQUEST_TIMEOUT=20
# 各平台允许的 Webhook 主机（防 SSRF），逗号分隔。不设置用官方默认@see App\Module\Cron\RobotPlatform
# WEBHOOK_HOST_WECOM=qyapi.weixin.qq.com
# WEBHOOK_HOST_DINGTALK=oapi.dingtalk.com
# WEBHOOK_HOST_FEISHU=open.feishu.cn,open.larkoffice.com


# ---------- Kubernetes Agent ----------
# Admin（cli.php）不读这些变量。集群内跑 Agent 可全部留空，自动读 ServiceAccount。
# Docker Desktop 本机：
#   kubectl apply -f deploy/kubernetes/local/docker-desktop.yaml
#   本机镜像：swoolefy-php85-swoole62:v1（imagePullPolicy: Never）
#   kubectl create token schedule-job-agent -n swoolefy --duration=8760h
#
# Kubernetes API 地址。集群外必填。Docker Desktop 只监听 127.0.0.1:6443，不要填局域网 IP
# K8S_API_SERVER=https://127.0.0.1:6443
# 集群外访问用的 ServiceAccount token。集群内留空，读 /var/run/secrets/.../token
# K8S_TOKEN=
# API Server CA 证书文件路径。不设且 K8S_VERIFY_TLS=1 时，集群内用 ServiceAccount 的 ca.crt
# K8S_CA_CERT_FILE=
# 是否校验 TLS。1=校验（生产）；0=跳过（仅本机 Docker Desktop 调试）
# K8S_VERIFY_TLS=0
# 允许 Create Job 的 Namespace，逗号分隔。空=不限制（生产必填）。任务的 k8s_spec.namespace 必须在名单内
# K8S_ALLOWED_NAMESPACES=swoolefy
# 单个Job等待上限（秒），协程同步等到 Job 结束，防止无限占着，时间到了Job Pod将被强制停止。主要是等待执行成功或者失败的状态返回。
# 实际Job等待秒数 = min(任务页面「Job填写的超时」, K8S_MAX_WAIT_SECONDS)
# K8S_MAX_WAIT_SECONDS=7200

# 轮询 Job 状态的间隔（秒）。越小越及时，对 API 压力越大
# K8S_POLL_INTERVAL=3
# Job 结束后由 K8s 自动删除Job Pod的 等待TTL（秒）。期内对象还在，方便查日志；到期删除Job+Pod。默认120
# K8S_JOB_TTL_SECONDS=120
# activeDeadlineSeconds = K8S_MAX_WAIT_SECONDS + 该值。让 schedule-job 先判超时，再由 K8s 杀 Job
# K8S_DEADLINE_PADDING=100
# 写入 cron_task_log.message 的 Pod 日志尾部行数。完整日志仍留在集群
# K8S_LOG_TAIL_LINES=50

# 是否拒绝 timeout=0 的 K8s 任务。1=必须 timeout>0（推荐）；0=回退到 K8S_MAX_WAIT_SECONDS
# K8S_REQUIRE_TIMEOUT=1

# 单次 Kubernetes HTTP 调用超时（秒），如 GET Deployment / POST Job，默认15s
# K8S_API_TIMEOUT=30
# K8s Worker 进程寿命(秒),Worker存活时间到了Agent扫描k8s任务的进程将重启，默认一天
# CRON_K8S_WORKER_LIFE_TIME=86400
# 本节点同时等待中的 Job 数上限约等于占用的协程数，防止长任务任务过多，占用协程一直在等待。至少设置1000以上，默认1000
# CRON_K8S_MAX_CONCURRENCY=1000
